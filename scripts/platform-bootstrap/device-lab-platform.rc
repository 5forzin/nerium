on post-fs-data
    exec_start device_lab_bootstrap

service device_lab_bootstrap /system/bin/sh /data/misc/device-lab/bootstrap/early.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
    timeout_period 60

on property:sys.boot_completed=1
    start device_lab_network

service device_lab_network /system/bin/sh /data/misc/device-lab/bootstrap/late.sh
    class late_start
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot
    timeout_period 30
